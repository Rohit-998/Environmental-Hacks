# Base URL of the AirDay API. Local dev server: http://localhost:8000. Deployed: the SAM ApiUrl output.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cognito (SAM outputs UserPoolId and UserPoolClientId). Leave empty locally to use the stand-in dev sign-in.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
