# AirDay backend settings. Copy to .env (gitignored) and fill in.
#
# Secrets: scripts/deploy.py pushes these to SSM Parameter Store as SecureString. The Lambdas read them from SSM
# at cold start; they are never stored as plaintext Lambda environment variables or committed to git.
# Locally, the dev server reads them straight from this file.

# Demo admin key. deploy.py generates a random one if this is empty.
ADMIN_KEY=
# Optional: official CPCB AQI from https://data.gov.in
DATA_GOV_API_KEY=
# Optional: station readings from https://explore.openaq.org
OPENAQ_API_KEY=
# Chat and translation model (Gemini while Bedrock is unavailable on this account), https://aistudio.google.com
GEMINI_API_KEY=
MODEL_PROVIDER=gemini
MODEL_ID=gemini-3.5-flash

# Deploy settings (CloudFormation parameters, not secret).
AWS_REGION=ap-south-1
STAGE=prod
STACK_NAME=airday-prod
# SES-verified sender address.
SES_SENDER=
# Alarms and budget alerts go here.
ALARM_EMAIL=
# The demo school's principal. Must also be SES-verified while the account is in the SES sandbox.
PRINCIPAL_EMAIL=
# Allow writes to the public demo school with the admin key. Set to false after the video.
DEMO_ADMIN=true
# Amplify URL of the dashboard, once it exists. Also the allowed CORS origin (plus localhost:3000).
DASHBOARD_URL=
